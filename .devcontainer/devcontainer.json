{
  "name": "TRS-80 Dev — Z80 Assembly with Cycle-True Model 1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "TechPrototyper.trszog"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/setup.sh",
  "forwardPorts": [5555],
  "portsAttributes": {
    "5555": {
      "label": "TRS-80 debug link",
      "onAutoForward": "ignore"
    }
  }
}
