{
  "name": "TRS-80 Dev — Z80 Assembly with Cycle-True Model 1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "postCreateCommand": "code --install-extension .devcontainer/trszog.vsix && bash .devcontainer/scripts/setup.sh",
  "forwardPorts": [5555],
  "portsAttributes": {
    "5555": {
      "label": "TRS-80 debug link",
      "onAutoForward": "ignore"
    }
  }
}
