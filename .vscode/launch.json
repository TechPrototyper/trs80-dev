{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "dezog",
            "request": "launch",
            "name": "TRS-80 (attach)",
            "remoteType": "revz",
            "rootFolder": "${workspaceFolder}",
            "revz": {
                "target": "fpga",
                "dongle": "fpga",
                "transport": {
                    "kind": "python",
                    "serial": "tcp:5555",
                    "bridge": "${workspaceFolder}/tools/trszog_bridge.py",
                    "autoStart": true,
                    "python": "/usr/bin/python3"
                }
            },
            "startAutomatically": false
        },
        {
            "type": "dezog",
            "request": "launch",
            "name": "TRS-80 (space_invaders, with symbols)",
            "remoteType": "revz",
            "rootFolder": "${workspaceFolder}",
            "revz": {
                "target": "fpga",
                "dongle": "fpga",
                "transport": {
                    "kind": "python",
                    "serial": "tcp:5555",
                    "bridge": "${workspaceFolder}/tools/trszog_bridge.py",
                    "autoStart": true,
                    "python": "/usr/bin/python3"
                }
            },
            "zmac": [
                { "path": "zout/space_invaders.bds" }
            ],
            "load": "zout/space_invaders.cmd",
            "topOfStack": "0x8000",
            "startAutomatically": false
        }
    ]
}
